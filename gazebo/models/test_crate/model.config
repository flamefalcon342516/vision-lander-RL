<?xml version="1.0"?>
<!-- model.config is the model's "package manifest": it lets
     <uri>model://test_crate</uri> resolve via GZ_SIM_RESOURCE_PATH. -->
<model>
  <name>test_crate</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>0.4 m, 2 kg cube used to learn spawning, teleporting and stepping.</description>
</model>
