<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    The rover is a moving landing platform, not a vehicle-dynamics study, so we
    make its motion EXACT and cheap: gravity off, chassis floating 2 cm above
    the ground (no wheel friction), and VelocityControl setting its body-frame
    twist every step from /model/<name>/cmd_vel. The rover path generator lives
    in Python (lander/sim/paths.py) and is shared with the fast env.
    Deck (top surface) at z = 0.30 m; the drone lands on it.
  -->
  <model name="lander_rover">
    <link name="chassis">
      <gravity>false</gravity>
      <inertial>
        <!-- Heavy, so a landing drone doesn't visibly push it around.
             Box 1.2 x 1.0 x 0.28: I = m(b^2+c^2)/12 etc. -->
        <mass>40</mass>
        <inertia>
          <ixx>3.59</ixx><iyy>5.06</iyy><izz>8.13</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <pose>0 0 0.16 0 0 0</pose>
      <collision name="chassis_collision">
        <geometry><box><size>1.2 1.0 0.28</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry><box><size>1.2 1.0 0.28</size></box></geometry>
        <material><ambient>0.2 0.25 0.6 1</ambient><diffuse>0.2 0.25 0.6 1</diffuse></material>
      </visual>
      <!-- Marker deck: a visual only (collision is the chassis top). Placed
           1 mm above the chassis top to avoid z-fighting. -->
      <visual name="marker_visual">
        <pose>0 0 0.141 0 0 0</pose>
        <geometry><box><size>0.6 0.6 0.001</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>model://lander_rover/materials/textures/aruco_marker.png</albedo_map>
            <roughness>0.9</roughness><metalness>0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <!-- Cosmetic wheels (visual only). -->
      <visual name="wheel_fl"><pose>0.42 0.53 -0.06 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="wheel_fr"><pose>0.42 -0.53 -0.06 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="wheel_rl"><pose>-0.42 0.53 -0.06 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="wheel_rr"><pose>-0.42 -0.53 -0.06 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
    </link>

    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    <!-- Model pose at a fixed SIM-time rate (unlike pose/info's 60 Hz wall). -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>
  </model>
</sdf>
