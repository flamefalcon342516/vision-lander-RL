      <visual name="hub_rr"><pose>-0.42 -0.596 -0.06 1.5708 0 0</pose><geometry><cylinder><radius>0.055</radius><length>0.004</length></cylinder></geometry><material><ambient>0.75 0.77 0.8 1</ambient><diffuse>0.75 0.77 0.8 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>
      <visual name="cap_rr"><pose>-0.42 -0.600 -0.06 1.5708 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.006</length></cylinder></geometry><material><ambient>0.95 0.45 0.08 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><specular>0.4 0.4 0.4 1</specular></material></visual>
      <visual name="fender_rr"><pose>-0.42 -0.550 0.055 0 0 0</pose><geometry><box><size>0.26 0.1 0.012</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.16 0.17 0.19 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
      <!-- Marker deck: a visual only (collision is the chassis top). Placed
           1 mm above the chassis top to avoid z-fighting. -->
      <visual name="marker_visual">
        <pose>0 0 0.141 0 0 0</pose>
        <geometry><box><size>0.6 0.6 0.001</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>model://lander_rover/materials/textures/aruco_marker.png</albedo_map>
            <roughness>0.9</roughness><metalness>0</metalness>
          </metal></pbr>
        </material>
      </visual>
    </link>

    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    <!-- Model pose at a fixed SIM-time rate (unlike pose/info's 60 Hz wall). -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>
  </model>
</sdf>
