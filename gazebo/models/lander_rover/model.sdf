<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    The rover is a moving landing platform, not a vehicle-dynamics study, so we
    make its motion EXACT and cheap: gravity off, chassis floating 2 cm above
    the ground (no wheel friction), and VelocityControl setting its body-frame
    twist every step from /model/<name>/cmd_vel. The rover path generator lives
    in Python (lander/sim/paths.py) and is shared with the fast env.
    Deck (top surface) at z = 0.30 m; the drone lands on it.
  -->
  <model name="lander_rover">
    <link name="chassis">
      <gravity>false</gravity>
      <inertial>
        <!-- Heavy, so a landing drone doesn't visibly push it around.
             Box 1.2 x 1.0 x 0.28: I = m(b^2+c^2)/12 etc. -->
        <mass>40</mass>
        <inertia>
          <ixx>3.59</ixx><iyy>5.06</iyy><izz>8.13</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <pose>0 0 0.16 0 0 0</pose>
      <collision name="chassis_collision">
        <geometry><box><size>1.2 1.0 0.28</size></box></geometry>
      </collision>
      <!-- Looks only: every visual below is cosmetic; physics is the single chassis box.
           Nothing rises above the deck except a 3 cm beacon in a rear corner, so the
           camera's view of the marker is unchanged. -->
      <visual name="hull"><pose>0 0 -0.02 0 0 0</pose><geometry><box><size>1.2 1.0 0.24</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.16 0.17 0.19 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
      <visual name="deck_plate"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>1.16 0.96 0.04</size></box></geometry><material><ambient>0.1 0.1 0.11 1</ambient><diffuse>0.1 0.1 0.11 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <visual name="stripe_l"><pose>0 0.501 -0.03 0 0 0</pose><geometry><box><size>1.0 0.002 0.05</size></box></geometry><material><ambient>0.95 0.45 0.08 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><specular>0.4 0.4 0.4 1</specular></material></visual>
      <visual name="stripe_r"><pose>0 -0.501 -0.03 0 0 0</pose><geometry><box><size>1.0 0.002 0.05</size></box></geometry><material><ambient>0.95 0.45 0.08 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><specular>0.4 0.4 0.4 1</specular></material></visual>
      <visual name="bumper_f"><pose>0.615 0 -0.08 0 0 0</pose><geometry><box><size>0.03 0.9 0.08</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
      <visual name="bumper_r"><pose>-0.615 0 -0.08 0 0 0</pose><geometry><box><size>0.03 0.9 0.08</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
      <visual name="nose_panel"><pose>0.601 0 0.02 0 0 0</pose><geometry><box><size>0.002 0.7 0.1</size></box></geometry><material><ambient>0.95 0.45 0.08 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><specular>0.4 0.4 0.4 1</specular></material></visual>
      <visual name="headlight_l"><pose>0.603 0.32 0.02 0 0 0</pose><geometry><box><size>0.004 0.12 0.05</size></box></geometry><material><ambient>1 1 0.9 1</ambient><diffuse>1 1 0.9 1</diffuse><specular>1.0 1.0 1.0 1</specular><emissive>1 1 0.85 1</emissive></material></visual>
